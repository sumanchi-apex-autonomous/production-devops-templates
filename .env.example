# Production Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO GIT REPOSITORIES

DOMAIN=localhost
ACME_EMAIL=admin@apexautonomous.com

# PostgreSQL Credentials
POSTGRES_USER=apex_admin
POSTGRES_PASSWORD=replace_with_secure_alphanumeric_password_32chars
POSTGRES_DB=apex_production_db

# Redis Credentials
REDIS_PASSWORD=replace_with_secure_redis_auth_token_32chars

# Observability Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_secure_grafana_dashboard_password

# Application Settings
LOG_LEVEL=info
NODE_ENV=production
